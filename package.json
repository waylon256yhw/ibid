{
  "name": "ibid-cli",
  "version": "0.1.0",
  "description": "Zero-hallucination local reference manager and citation verifier CLI for humans and AI Agents",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/waylon256yhw/ibid.git"
  },
  "homepage": "https://waylon256yhw.github.io/ibid/",
  "keywords": [
    "bibliography",
    "citation",
    "csl",
    "bibtex",
    "doi",
    "pubmed",
    "arxiv",
    "agent-skill",
    "cli"
  ],
  "bin": {
    "ibid": "bin/ibid"
  },
  "files": [
    "bin/ibid",
    "src/",
    "styles/",
    "scripts/postinstall.mjs",
    "skills/"
  ],
  "scripts": {
    "check": "bun check",
    "test": "bun test",
    "build": "bun build --compile src/cli.ts --outfile dist/ibid",
    "build:release": "bun scripts/package-release.ts",
    "postinstall": "node scripts/postinstall.mjs"
  },
  "dependencies": {
    "@citation-js/core": "0.9.0",
    "@citation-js/plugin-bibtex": "0.9.0",
    "@citation-js/plugin-csl": "0.9.0",
    "@effect/platform-bun": "4.1.2",
    "effect": "4.1.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
